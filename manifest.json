{
"manifest_version": 3,
"minimum_chrome_version": "111",
"name": "Jable Collect",
"version": "1.0.1",
"description": "抓取、整理和浏览 Jable 收藏与稍后观看数据",
"permissions": [
  "storage",
  "activeTab",
  "scripting",
  "tabs"
],
"host_permissions": [
  "https://jable.tv/*",
  "https://missav.ws/*",
  "https://missav.ai/*",
  "https://missav.live/*"
],
"background": {
  "service_worker": "background.js"
},
"content_scripts": [
  {
    "matches": ["https://jable.tv/my/favourites/*"],
    "js": ["sync-status-ui.js", "content.js"]
  },
  {
    "matches": ["https://jable.tv/videos/*"],
    "js": ["content-jable-detail.js"],
    "run_at": "document_start"
  },
  {
    "matches": [
      "https://missav.ws/saved*",
      "https://missav.ws/*/saved*",
      "https://missav.ai/saved*",
      "https://missav.ai/*/saved*",
      "https://missav.live/saved*",
      "https://missav.live/*/saved*"
    ],
    "js": ["missav-shared.js", "sync-status-ui.js", "content-missav.js"]
  },
  {
    "matches": [
      "https://missav.ws/*",
      "https://missav.ai/*",
      "https://missav.live/*"
    ],
    "js": ["missav-shared.js", "content-missav-detail.js"],
    "run_at": "document_start"
  }
],
"web_accessible_resources": [
  {
    "resources": ["content-jable-detail-hook.js"],
    "matches": ["https://jable.tv/*"]
  },
  {
    "resources": ["missav-shared.js", "content-missav-detail-hook.js"],
    "matches": [
      "https://missav.ws/*",
      "https://missav.ai/*",
      "https://missav.live/*"
    ]
  }
],
"action": {
  "default_popup": "popup.html",
  "default_title": "Jable Collect"
},
"options_page": "options.html"
}
